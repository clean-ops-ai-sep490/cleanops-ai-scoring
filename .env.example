# CleanOps AI scoring local/dev runtime
# For production deploy, prefer the smaller templates:
# - .env.api.example: cleanops-ai-scoring-api inference + retrain bridge.
# - .env.trainer.example: cleanops-ai-scoring-trainer training runtime.

APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
REQUEST_TIMEOUT_SEC=30
INFERENCE_DEADLINE_SEC=30
APP_PUBLIC_BASE_URL=http://localhost:8000

# Inference limits
MAX_BATCH_IMAGES=5
INFERENCE_BATCH_CONCURRENCY=2
PENDING_LOWER_BOUND=50

# Active model paths and storage
BASE_OUTPUT_DIR=outputs
MODEL_CACHE_DIR=model-cache
MODEL_PATH=
UNET_MODEL_PATH=models/unet_multiclass_best.pth
UNET_IMG_SIZE=384
YOLO_CONF=0.25
MODEL_STORAGE_ENABLED=true
MODEL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
MODEL_STORAGE_CONTAINER=models
MODEL_STORAGE_ACTIVE_YOLO_KEY=scoring/active/yolo/model.pt
MODEL_STORAGE_ACTIVE_UNET_KEY=scoring/active/unet/model.pth
MODEL_STORAGE_ACTIVE_PPE_KEY=ppe/active/model.pt
MODEL_FORCE_REFRESH=false
MODEL_REQUIRE_BLOB=true

# Auxiliary foundation segmentation
# Keep response contract key `sam3` for backend compatibility.
# Demo-preferred provider is Roboflow Workflow because it avoids local CUDA/SAM3 requirements.
SAM3_ENABLED=true
SAM3_REQUIRED=false
SAM3_PROVIDER=roboflow
SAM3_TIMEOUT_FALLBACK_ENABLED=true
SAM3_MIN_TIMEOUT_SEC=1
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=nams-workspace-fykkb
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-14
ROBOFLOW_CLASSES=Garbage, Trash, Debris, Stain, Wet_Floor
ROBOFLOW_DIRTY_LABELS=Garbage, Stain, dirty_area, marks, trash, debris
ROBOFLOW_WET_LABELS=Wet_Floor, wet_surface, water, spill, puddle
ROBOFLOW_USE_CACHE=true

# Local SAM3 compatibility path
SAM3_CHECKPOINT_PATH=model-cache/sam3/sam3.pt
SAM3_RESOLUTION=1008
SAM3_CONFIDENCE_THRESHOLD=0.3
SAM3_PROMPTS=dirty area
SAM3_MAX_PROMPTS=7
SAM3_MIN_MASK_AREA_PX=64
SAM3_DEVICE=cpu
SAM3_USE_BFLOAT16=true

# Domain scoring
SCORING_PENALTY_LABELS=metal,paper,plastic,trash,marks,garbage,rubbish,litter,waste,debris,bottle,plastic_bottle,can,cup,cardboard,bag,trash_bag,stain_object,garbage_object
SCORING_OBJECT_PENALTY_PER_DETECTION=10
SCORING_CALIBRATION_ENABLED=true
SCORING_HIGH_RISK_REVIEW_ENVS=RESTROOM,HOSPITAL_OR
SCORING_IGNORED_OBJECT_REVIEW_COUNT=2
SCORING_IGNORED_OBJECT_REVIEW_LABELS=person,skis,snowboard
SCORING_UNET_ONLY_REVIEW_MIN_PCT=20
SCORING_UNET_ONLY_REVIEW_MAX_PCT=60
SCORING_SINGLE_SAM3_REVIEW_MAX_PREDICTIONS=1
SCORING_STRONG_DIRTY_COVERAGE_PCT=45
ENV_PASS_THRESHOLD_LOBBY_CORRIDOR=90
ENV_PASS_THRESHOLD_RESTROOM=85
ENV_PASS_THRESHOLD_BASEMENT_PARKING=80
ENV_PASS_THRESHOLD_GLASS_SURFACE=90
ENV_PASS_THRESHOLD_OUTDOOR_LANDSCAPE=80
ENV_PASS_THRESHOLD_HOSPITAL_OR=95

# Visualization output
VISUALIZE_JPEG_QUALITY=92
VISUALIZATION_BLOB_ENABLED=true
VISUALIZATION_BLOB_CONNECTION_STRING=
VISUALIZATION_BLOB_CONTAINER=visualizations
VISUALIZATION_BLOB_PREFIX=scoring/visualizations

# PPE detector with optional Gemini missing-only verification
PPE_ENABLED=true
PPE_MODEL_PATH=model-cache/active/ppe/model.pt
PPE_DEFAULT_MIN_CONFIDENCE=0.25
PPE_GEMINI_ENABLED=true
PPE_GEMINI_MODE=missing_only
PPE_GEMINI_MODEL=gemini-2.5-flash-lite
PPE_GEMINI_TIMEOUT_SEC=30
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
