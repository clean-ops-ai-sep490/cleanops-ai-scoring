# CleanOps scoring API deploy env
# Use this for the main cleanops-ai-scoring-api container.
# Stable runtime, scoring, PPE, visualization, and retrain defaults are pinned in docker-compose.yml.

# Public API URL used when payloads need absolute URLs.
APP_PUBLIC_BASE_URL=https://<your-api-domain>

# Required: active YOLO/U-Net/PPE models are loaded from Azure Blob in strict mode.
MODEL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<account_key>;EndpointSuffix=core.windows.net

# Required: Roboflow auxiliary segmentation is part of production scoring quality.
ROBOFLOW_API_KEY=<roboflow-key>

# Required: scoring API forwards /retrain/jobs to this trainer endpoint.
RETRAIN_TRAINER_BASE_URL=https://<your-ngrok-or-trainer-domain>

# Optional: set when backend protects /retrain/jobs with X-Retrain-Api-Key.
RETRAIN_API_KEY=

# Optional: set when trainer protects /trainer/jobs with X-Trainer-Api-Key.
RETRAIN_TRAINER_API_KEY=

# Optional: leave empty to reuse MODEL_STORAGE_CONNECTION_STRING.
VISUALIZATION_BLOB_CONNECTION_STRING=
RETRAIN_STORAGE_CONNECTION_STRING=

# PPE detector with Gemini missing-only verification enabled by default.
PPE_GEMINI_ENABLED=true
PPE_GEMINI_MODE=missing_only
PPE_GEMINI_MODEL=gemini-2.5-flash-lite
PPE_GEMINI_TIMEOUT_SEC=8
GEMINI_API_KEY=<gemini-api-key>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
