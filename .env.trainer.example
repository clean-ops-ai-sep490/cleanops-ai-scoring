# CleanOps scoring local trainer env
# Use this on the machine that hosts the trainer with a Python venv + ngrok.
# Suggested start command on Windows:
#   .\.venv\Scripts\python.exe -m uvicorn src.trainer_api:app --host 0.0.0.0 --port 8001 --env-file .env.trainer.local
# Then expose it:
#   ngrok http 8001
# Put the ngrok HTTPS URL into API env RETRAIN_TRAINER_BASE_URL.

# Trainer API wrapper
TRAINER_API_ENABLED=true
TRAINER_API_KEY=<same-as-RETRAIN_TRAINER_API_KEY>
TRAINER_COMMAND=.\.venv\Scripts\python.exe scripts\run_retrain_pipeline.py
TRAINER_TIMEOUT_SEC=7200
TRAINER_WORKDIR=E:\capstone\retrain-fe\cleanops-ai-scoring

# Shared Blob storage
MODEL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
RETRAIN_STORAGE_CONNECTION_STRING=
RETRAIN_CONTAINER=retrain
RETRAIN_EXTERNAL_PREFIX=scoring/external/latest
RETRAIN_CANDIDATE_ARCHIVE_PREFIX=scoring/external/candidates

# Active baseline models downloaded from Blob before training
RETRAIN_USE_ACTIVE_BASELINE=true
RETRAIN_REQUIRE_ACTIVE_BASELINE=true
RETRAIN_ALLOW_BASE_FALLBACK=false
RETRAIN_ACTIVE_MODELS_CONTAINER=models
RETRAIN_ACTIVE_YOLO_KEY=scoring/active/yolo/model.pt
RETRAIN_ACTIVE_UNET_KEY=scoring/active/unet/model.pth
RETRAIN_ACTIVE_BASE_ROOT=data/retrain_active_base

# Reviewed samples dataset
RETRAIN_SAMPLES_CONTAINER=retrain-samples
RETRAIN_SAMPLES_PREFIX=scoring/retrain-samples
RETRAIN_DATASET_ROOT=data/retrain_bridge
RETRAIN_MIN_APPROVED_ANNOTATIONS=5
RETRAIN_DATASET_LIMIT=5
RETRAIN_TRAIN_RATIO=0.8
RETRAIN_VALID_RATIO=0.1
RETRAIN_ONLY_AFTER_DATE=

# YOLO candidate settings. Default freezes YOLO and reuses active artifact.
RETRAIN_FREEZE_YOLO=true
RETRAIN_YOLO_MODEL=yolov8n.pt
RETRAIN_YOLO_EPOCHS=1
RETRAIN_YOLO_BATCH=1
RETRAIN_YOLO_IMGSZ=320
RETRAIN_YOLO_DEVICE=auto
RETRAIN_YOLO_HALF=true
RETRAIN_YOLO_WORKERS=0
RETRAIN_YOLO_PROJECT_DIR=outputs/retrain/yolo_training
RETRAIN_YOLO_RUN_NAME=candidate

# U-Net candidate settings
RETRAIN_UNET_EPOCHS=1
RETRAIN_UNET_BATCH=1
RETRAIN_UNET_IMGSZ=256
RETRAIN_UNET_WORKERS=0
RETRAIN_UNET_ENCODER=resnet18
RETRAIN_UNET_ENCODER_WEIGHTS=none

# Candidate artifact paths on the local trainer machine
RETRAIN_CANDIDATE_YOLO_FILE=outputs/retrain/candidate/yolo_best.pt
RETRAIN_CANDIDATE_UNET_FILE=outputs/retrain/candidate/unet_best.pth
RETRAIN_CANDIDATE_METRICS_FILE=outputs/retrain/candidate_metrics.json
